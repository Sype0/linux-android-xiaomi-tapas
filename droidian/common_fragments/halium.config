# Halium requirements for android13-5.15 GKI.
# Everything here must keep the GKI module ABI (KMI) intact, as the stock
# vendor modules are reused. SYSVIPC relies on the KABI padding change done
# by scripts/sysvipc-kabi.py.
CONFIG_SYSVIPC=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_IPC_NS=y
CONFIG_VT=y
CONFIG_NULL_TTY=y
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y

# CONFIG_LTO_CLANG_FULL is not set
CONFIG_LTO_CLANG_THIN=y

# Do not enforce kernel modules signature
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_PROTECT is not set
